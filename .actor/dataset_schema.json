{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Air Care Taxonomy Output",
            "transformation": {
                "fields": [
                    "device_id",
                    "brand_code",
                    "title",
                    "pack_format_code",
                    "reviews_count",
                    "classification_status"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "device_id": {
                        "label": "Device ID",
                        "format": "text"
                    },
                    "brand_code": {
                        "label": "Brand Code",
                        "format": "text"
                    },
                    "title": {
                        "label": "Product Title",
                        "format": "text"
                    },
                    "pack_format_code": {
                        "label": "Format",
                        "format": "text"
                    },
                    "reviews_count": {
                        "label": "Reviews",
                        "format": "number"
                    },
                    "classification_status": {
                        "label": "Status",
                        "format": "text"
                    }
                }
            }
        }
    }
}
